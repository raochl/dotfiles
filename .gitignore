# Anything ending with a tilde 
*~

# Anything ending with a .class 
*.class

# Any vim temp files 
*.swp
*.swo


# workbench backup files 
*.bak 

*.log*
.nvimlog
*.old

# Runtime tmux plugins installed by TPM. Keep the TPM submodule tracked.
tmux/plugins/*
!tmux/plugins/tpm/

# Private overrides belong outside the portable configuration.
/.gitconfig_local
/.proxyrc
/proxy.local.sh
/.zshrc_local*
/.bashrc_local
/localDot/
